 Tři bliknutí při novém rekordu\n        for (let i = 0; i < 3; i++) {\n            basic.pause(250)\n            basic.clearScreen()\n            basic.pause(250)\n\n            for (let j = 0; j < pocetLed; j++) {\n                led.plot(j % 5, Math.floor(j / 5))\n            }\n        }\n    }\n\n    // Obrazec zůstane rozsvícený až do dalšího stisku A\n})\n\ninput.onButtonPressed(Button.AB, function () {\n    if (bezi) {\n        return\n    }\n\n    basic.clearScreen()\n    basic.showString(\"BEST\")\n    basic.showNumber(rekord)\n\n    // Po zobrazení rekordu se vrátí obrazec posledního výsledku,\n    // pokud nějaký existuje.\n    if (vysledek) {\n        let pocetLed = Math.min(25, Math.ceil(cas / 20))\n        basic.clearScreen()\n\n        for (let i = 0; i < pocetLed; i++) {\n            led.plot(i % 5, Math.floor(i / 5))\n        }\n    } else {\n        basic.showString(\"A=START\")\n    }\n})\n","README.md":"","main.py":"def on_button_pressed_a():\n    global start\n    basic.show_string(\"CEKEJ\")\n    basic.pause(2000)\n    basic.show_icon(IconNames.HEART)\n    start = input.running_time()\ninput.on_button_pressed(Button.A, on_button_pressed_a)\n\ndef on_button_pressed_b():\n    global CAS\n    CAS = input.running_time() - start\n    basic.show_number(CAS)\ninput.on_button_pressed(Button.B, on_button_pressed_b)\n\nCAS = 0\nstart = 0\nrekord = 0","pxt.json":"{\n    \"name\": \"reflexní souboj\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}}],"shares":[],"lastSaveTime":1792323125748}